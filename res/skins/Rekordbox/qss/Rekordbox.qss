/* CUSTOM MOD (rekordbox-skin): Rekordbox DARK Performance theme for local Mixxx build
   Dark performance zone + light library zone, matching rekordbox 7.x spec.
   Performance background #0B0B10, panels #15151A, borders #2A2A30,
   accent blue #00a0e9, text-on-dark #F2F2F5. AI-generated. */

WWidget {
  background-color: #0B0B10;
  color: #F2F2F5;
}

/* Performance zone containers */
#SkinContainer,
#RbRowBeatFx,
#RbRowCfx,
#RbRowMergeFx,
#RbRowDecks,
#RbRowBeatJump,
#RbRowMixer,
#RbRowPadFx,
#RbMasterPanel,
#RbDeckCard,
#RbDeckHeader,
#RbJogCluster,
#RbChannelStrip,
#RbFxUnitPanel,
#RbCfxPanel,
#RbMergeFxPanel,
#RbPadFxPanel,
#RbRowRecordingAutomix,
#RbRecordingPanel,
#RbAutomixPanel,
#RbSequencerPanel,
#RbSeqSlot1,
#RbSeqSlot2,
#RbSeqSlot3,
#RbSeqSlot4,
#RbSeqSlot5,
#RbSeqSlot6,
#RbSeqSlot7,
#RbSeqSlot8,
#RbSeqRecord,
#RbSeqPlay,
#RbSeqMute,
#RbSeqErase,
#RbSeqMetronome,
#RbBeatJumpBack,
#RbBeatJumpForward,
#RbBeatJumpSizeDown,
#RbBeatJumpSizeUp,
#RbKeyShiftUp,
#RbKeyShiftDown {
  background-color: #15151A;
  border: 1px solid #2A2A30;
  border-radius: 4px;
}

/* Library zone — light by default, dark variant supported via stylesheet swap */
#RbLibraryContainer {
  background-color: #FAFAFA;
  border-top: 1px solid #2A2A30;
  color: #1A1A1A;
}

WLabel {
  color: #F2F2F5;
  background-color: transparent;
  font-size: 11px;
}

#RbFxUnitHeader,
#RbCfxHeader,
#RbDeckTitle,
#RbPadFxHeader,
#RbMixerChanLabel,
#RbMergeFxLabel {
  color: #F2F2F5;
  font-size: 10px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

#RbDeckArtist,
#RbDeckTrack,
#RbBpmValue,
#RbKeyValue,
#RbTimeValue {
  color: #F2F2F5;
  font-size: 12px;
  font-family: "Consolas", "Courier New", monospace;
}

WPushButton {
  color: #F2F2F5;
  background-color: transparent;
  border: none;
  font-size: 10px;
  text-transform: uppercase;
}

#RbPlayButton,
#RbCueButton,
#RbSyncButton {
  font-size: 11px;
}

#RbHotcueButton {
  font-size: 12px;
  font-weight: bold;
}

#RbFxToggleButton,
#RbCfxButton,
#RbCfxGate,
#RbPadButton,
#RbPadRouteButton,
#RbPadEditButton,
#RbRateReset,
#RbCueHeadButton,
#RbMergeFxButton {
  color: #F2F2F5;
}

/* Dark EffectSelector / chain buttons */
WEffectSelector {
  background-color: #1E1E24;
  color: #F2F2F5;
  border: 1px solid #2A2A30;
  border-radius: 3px;
}

WKnobComposed {
  background-color: transparent;
}

WSliderComposed {
  background-color: transparent;
}
