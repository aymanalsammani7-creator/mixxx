/* CUSTOM MOD (rekordbox-skin): Rekordbox Light theme for local Mixxx build
   Minimal light Rekordbox-style stylesheet.
   Canvas #EBEBEB, white containers #FFFFFF, 1px grey borders #CCCCCC,
   rounded (border-radius 4px), blue accent #00a0e9. Button states drawn by
   graphics/btn.svg + graphics/btn_active.svg (referenced from skin XML),
   but recolored as light-card variants in Step 2. AI-generated. */

WWidget {
  background-color: #EBEBEB;
}

/* Global white card containers for Decks / Mixer / FX panels */
#SkinContainer,
#RbRowBeatFx,
#RbRowCfx,
#RbRowDecks,
#RbRowMixer,
#RbRowPadFx,
#RbMasterPanel,
RbDeckCard,
#RbDeckCard {
  background-color: #FFFFFF;
  border: 1px solid #CCCCCC;
  border-radius: 4px;
}

WLabel {
  color: #1a1a1a;
  background-color: transparent;
  font-size: 11px;
}

#RbFxUnitHeader,
#RbCfxHeader,
#RbDeckTitle,
#RbPadFxHeader {
  color: #1a1a1a;
  font-size: 12px;
  font-weight: bold;
}

#RbMixerChanLabel {
  color: #1a1a1a;
  font-size: 10px;
}

WPushButton {
  color: #1a1a1a;
  background-color: transparent;
  border: none;
  font-size: 10px;
}

#RbPlayButton,
#RbCueButton,
#RbSyncButton {
  font-size: 11px;
}

#RbHotcueButton {
  font-size: 12px;
  font-weight: bold;
}

#RbFxToggleButton,
#RbCfxButton,
#RbCfxGate,
#RbPadButton,
#RbPadRouteButton,
#RbPadEditButton,
#RbRateReset,
#RbCueHeadButton {
  color: #333333;
}

/* Light EffectSelector / chain buttons (CFX & Beat FX panels) */
WEffectSelector {
  background-color: #F5F5F5;
  color: #1a1a1a;
  border: 1px solid #CCCCCC;
  font-size: 10px;
}

WEffectChainPresetButton {
  background-color: #F5F5F5;
  color: #1a1a1a;
  border: 1px solid #CCCCCC;
  font-size: 10px;
}

WSplitter::handle {
  background-color: #CCCCCC;
}

/* Library: light sidebar + table */
WTreeWidget {
  background-color: #FFFFFF;
  color: #1a1a1a;
  border: 1px solid #CCCCCC;
  font-size: 11px;
}

QTableView {
  background-color: #FFFFFF;
  color: #1a1a1a;
  gridline-color: #E0E0E0;
  font-size: 11px;
}

QHeaderView {
  background-color: #F5F5F5;
  color: #1a1a1a;
  font-size: 10px;
  border: 1px solid #CCCCCC;
}

