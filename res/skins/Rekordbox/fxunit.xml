<!-- CUSTOM MOD (rekordbox-skin): Rekordbox-style Beat FX rack (FX1/FX2) -->
<!--
  Mirrored module: FX1 for left side, FX2 for right.
  Variables:
    FxUnit : 1..2
-->
<Template>
  <SetVariable name="FxUnitGroup">[EffectRack1_EffectUnit<Variable name="FxUnit"/>]</SetVariable>

  <WidgetGroup>
    <ObjectName>RbFxUnitPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <Label>
        <ObjectName>RbFxUnitHeader</ObjectName>
        <Size>me,18f</Size>
        <Text>FX <Variable name="FxUnit"/></Text>
      </Label>

      <!-- Channel-assign grid: 1 2 S / 3 4 M -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <PushButton>
            <TooltipId>EffectUnit_deck_enabled</TooltipId>
            <ObjectName>RbFxDeckAssign</ObjectName>
            <Size>20f,18f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>1</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>1</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Channel1_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectUnit_deck_enabled</TooltipId>
            <ObjectName>RbFxDeckAssign</ObjectName>
            <Size>20f,18f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>2</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>2</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Channel2_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectUnit_sampler_enabled</TooltipId>
            <ObjectName>RbFxDeckAssign</ObjectName>
            <Size>20f,18f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>S</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>S</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Sampler_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <PushButton>
            <TooltipId>EffectUnit_deck_enabled</TooltipId>
            <ObjectName>RbFxDeckAssign</ObjectName>
            <Size>20f,18f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>3</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>3</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Channel3_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectUnit_deck_enabled</TooltipId>
            <ObjectName>RbFxDeckAssign</ObjectName>
            <Size>20f,18f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>4</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>4</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Channel4_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectUnit_master_enabled</TooltipId>
            <ObjectName>RbFxDeckAssign</ObjectName>
            <Size>20f,18f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>M</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>M</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Master_enable</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <!-- … more button -->
      <PushButton>
        <TooltipId>show_effects</TooltipId>
        <ObjectName>RbFxMoreButton</ObjectName>
        <Size>20f,18f</Size>
        <NumberStates>1</NumberStates>
        <State>
          <Number>0</Number>
          <Text>...</Text>
          <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
          <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
        </State>
        <Connection>
          <ConfigKey>[Skin],show_effectrack</ConfigKey>
        </Connection>
      </PushButton>

      <!-- Three FX slots -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>

          <WidgetGroup><!-- Slot 1 -->
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <PushButton>
                <TooltipId>EffectSlot_enabled</TooltipId>
                <ObjectName>RbFxToggleButton</ObjectName>
                <Size>34f,20f</Size>
                <NumberStates>2</NumberStates>
                <RightClickIsPushButton>false</RightClickIsPushButton>
                <State>
                  <Number>0</Number>
                  <Text>&#160;</Text>
                  <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
                  <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>ON</Text>
                  <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
                  <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
                </State>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect1,enabled</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
              <KnobComposed>
                <TooltipId>EffectSlot_metaknob</TooltipId>
                <ObjectName>RbFxParamKnob</ObjectName>
                <Size>30f,26f</Size>
                <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
                <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
                <MinAngle>-130</MinAngle>
                <MaxAngle>130</MaxAngle>
                <ArcRadius>10.0</ArcRadius>
                <ArcUnipolar>true</ArcUnipolar>
                <ArcColor>#00a0e9</ArcColor>
                <ArcThickness>2</ArcThickness>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect1,meta</ConfigKey>
                </Connection>
              </KnobComposed>
              <EffectSelector>
                <MinimumSize>90,20</MinimumSize>
                <MaximumSize>,20</MaximumSize>
                <SizePolicy>me,f</SizePolicy>
                <EffectRack>1</EffectRack>
                <EffectUnit><Variable name="FxUnit"/></EffectUnit>
                <Effect>1</Effect>
              </EffectSelector>
              <ValueLabel>
                <ObjectName>RbFxParamValue</ObjectName>
                <Size>30f,20f</Size>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect1,meta</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                </Connection>
              </ValueLabel>
            </Children>
          </WidgetGroup>

          <WidgetGroup><!-- Slot 2 -->
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <PushButton>
                <TooltipId>EffectSlot_enabled</TooltipId>
                <ObjectName>RbFxToggleButton</ObjectName>
                <Size>34f,20f</Size>
                <NumberStates>2</NumberStates>
                <RightClickIsPushButton>false</RightClickIsPushButton>
                <State>
                  <Number>0</Number>
                  <Text>&#160;</Text>
                  <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
                  <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>ON</Text>
                  <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
                  <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
                </State>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect2,enabled</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
              <KnobComposed>
                <TooltipId>EffectSlot_metaknob</TooltipId>
                <ObjectName>RbFxParamKnob</ObjectName>
                <Size>30f,26f</Size>
                <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
                <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
                <MinAngle>-130</MinAngle>
                <MaxAngle>130</MaxAngle>
                <ArcRadius>10.0</ArcRadius>
                <ArcUnipolar>true</ArcUnipolar>
                <ArcColor>#00a0e9</ArcColor>
                <ArcThickness>2</ArcThickness>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect2,meta</ConfigKey>
                </Connection>
              </KnobComposed>
              <EffectSelector>
                <MinimumSize>90,20</MinimumSize>
                <MaximumSize>,20</MaximumSize>
                <SizePolicy>me,f</SizePolicy>
                <EffectRack>1</EffectRack>
                <EffectUnit><Variable name="FxUnit"/></EffectUnit>
                <Effect>2</Effect>
              </EffectSelector>
              <ValueLabel>
                <ObjectName>RbFxParamValue</ObjectName>
                <Size>30f,20f</Size>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect2,meta</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                </Connection>
              </ValueLabel>
            </Children>
          </WidgetGroup>

          <WidgetGroup><!-- Slot 3 -->
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <PushButton>
                <TooltipId>EffectSlot_enabled</TooltipId>
                <ObjectName>RbFxToggleButton</ObjectName>
                <Size>34f,20f</Size>
                <NumberStates>2</NumberStates>
                <RightClickIsPushButton>false</RightClickIsPushButton>
                <State>
                  <Number>0</Number>
                  <Text>&#160;</Text>
                  <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
                  <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>ON</Text>
                  <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
                  <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
                </State>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect3,enabled</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
              <KnobComposed>
                <TooltipId>EffectSlot_metaknob</TooltipId>
                <ObjectName>RbFxParamKnob</ObjectName>
                <Size>30f,26f</Size>
                <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
                <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
                <MinAngle>-130</MinAngle>
                <MaxAngle>130</MaxAngle>
                <ArcRadius>10.0</ArcRadius>
                <ArcUnipolar>true</ArcUnipolar>
                <ArcColor>#00a0e9</ArcColor>
                <ArcThickness>2</ArcThickness>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect3,meta</ConfigKey>
                </Connection>
              </KnobComposed>
              <EffectSelector>
                <MinimumSize>90,20</MinimumSize>
                <MaximumSize>,20</MaximumSize>
                <SizePolicy>me,f</SizePolicy>
                <EffectRack>1</EffectRack>
                <EffectUnit><Variable name="FxUnit"/></EffectUnit>
                <Effect>3</Effect>
              </EffectSelector>
              <ValueLabel>
                <ObjectName>RbFxParamValue</ObjectName>
                <Size>30f,20f</Size>
                <Connection>
                  <ConfigKey><Variable name="FxUnitGroup"/>_Effect3,meta</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                </Connection>
              </ValueLabel>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetGroup>

      <!-- BACK SPIN block -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <Label>
            <Text>BACK SPIN</Text>
          </Label>
          <PushButton>
            <ObjectName>RbBackSpinAuto</ObjectName>
            <Size>30f,20f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>AUTO</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>AUTO</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,backspin_auto</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RbBackSpinTap</ObjectName>
            <Size>30f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>TAP</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,backspin_tap</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <ValueLabel>
            <ObjectName>RbBackSpinBeats</ObjectName>
            <Size>20f,20f</Size>
            <Connection>
              <ConfigKey><Variable name="Group"/>,backspin_beats</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </ValueLabel>
        </Children>
      </WidgetGroup>

      <!-- Stems pills (FX2 only) -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <PushButton>
            <ObjectName>RbStemInst</ObjectName>
            <Size>40f,20f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>INST</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>INST</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,stem_inst</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RbStemVocal</ObjectName>
            <Size>40f,20f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>VOCAL</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>VOCAL</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,stem_vocal</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RbStemDrums</ObjectName>
            <Size>40f,20f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>DRUMS</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>DRUMS</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,stem_drums</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <!-- Unit-level controls -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <KnobComposed>
            <TooltipId>EffectUnit_mix</TooltipId>
            <Size>30f,26f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_red.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>10.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#a00000</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,mix</ConfigKey>
            </Connection>
          </KnobComposed>
          <KnobComposed>
            <TooltipId>EffectUnit_super1</TooltipId>
            <Size>30f,26f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>10.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,super1</ConfigKey>
            </Connection>
          </KnobComposed>
          <EffectChainPresetButton>
            <EffectUnit><Variable name="FxUnit"/></EffectUnit>
            <Size>60f,20f</Size>
            <ObjectName>RbChainPreset</ObjectName>
          </EffectChainPresetButton>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
