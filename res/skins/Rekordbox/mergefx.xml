<!-- CUSTOM MOD (rekordbox-skin): Rekordbox-style MERGE FX row -->
<!--
  MFX1 (decks 1/3) + MFX2 (decks 2/4).
  Full MERGE FX controls: preset slots, effect selector, next/back/cancel,
  parameter, on/off, sample vol, deck assignment, settings.
-->
<Template>
