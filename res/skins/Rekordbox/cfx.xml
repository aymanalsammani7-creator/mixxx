<!-- CUSTOM MOD (rekordbox-skin): Rekordbox-style CFX row -->
<!--
  Per-deck Sound Color FX mini panel.
  Variables:
    ChanNum : 1..4
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <SetVariable name="QuickEffectRack">[QuickEffectRack1_<Variable name="Group"/>]</SetVariable>
  <SetVariable name="QuickEffectSlot">[QuickEffectRack1_<Variable name="Group"/>_EffectSlot1]</SetVariable>

  <WidgetGroup>
    <ObjectName>RbCfxPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <Label>
            <ObjectName>RbCfxHeader</ObjectName>
            <Size>30f,16f</Size>
            <Text>CFX&#8202;<Variable name="ChanNum"/></Text>
          </Label>
          <PushButton>
            <ObjectName>RbCfxMulti</ObjectName>
            <Size>20f,16f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>•••</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Filter</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RbCfxDot</ObjectName>
            <Size>20f,16f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>•</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,clear</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <PushButton>
            <ObjectName>RbCfxDefault</ObjectName>
            <Size>40f,20f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>DEFAULT</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>DEFAULT</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,clear</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RbCfxUser</ObjectName>
            <Size>40f,20f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>USER</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>USER</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectRack"/>,user_mode</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>

          <PushButton>
            <TooltipId>QuickEffectRack_enabled</TooltipId>
            <ObjectName>RbCfxGate</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>FILTER</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>FILTER</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectRack"/>,enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <KnobComposed>
            <TooltipId>QuickEffectRack_super1</TooltipId>
            <ObjectName>RbCfxParamKnob</ObjectName>
            <Size>30f,26f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>10.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="QuickEffectRack"/>,super1</ConfigKey>
            </Connection>
          </KnobComposed>

          <ValueLabel>
            <ObjectName>RbCfxParamValue</ObjectName>
            <Size>30f,20f</Size>
            <Connection>
              <ConfigKey><Variable name="QuickEffectRack"/>,super1</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </ValueLabel>

        </Children>
      </WidgetGroup>

      <!-- Per-channel CFX knobs: S 3 1 2 4 M -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <KnobComposed>
            <TooltipId>EffectUnit_sampler_enabled</TooltipId>
            <ObjectName>RbCfxChannelKnob</ObjectName>
            <Size>20f,20f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>8.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Sampler_enable</ConfigKey>
            </Connection>
          </KnobComposed>
          <KnobComposed>
            <TooltipId>EffectUnit_deck_enabled</TooltipId>
            <ObjectName>RbCfxChannelKnob</ObjectName>
            <Size>20f,20f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>8.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Channel3_enable</ConfigKey>
            </Connection>
          </KnobComposed>
          <KnobComposed>
            <TooltipId>EffectUnit_deck_enabled</TooltipId>
            <ObjectName>RbCfxChannelKnob</ObjectName>
            <Size>20f,20f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>8.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Channel1_enable</ConfigKey>
            </Connection>
          </KnobComposed>
          <KnobComposed>
            <TooltipId>EffectUnit_deck_enabled</TooltipId>
            <ObjectName>RbCfxChannelKnob</ObjectName>
            <Size>20f,20f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>8.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Channel2_enable</ConfigKey>
            </Connection>
          </KnobComposed>
          <KnobComposed>
            <TooltipId>EffectUnit_deck_enabled</TooltipId>
            <ObjectName>RbCfxChannelKnob</ObjectName>
            <Size>20f,20f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>8.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Channel4_enable</ConfigKey>
            </Connection>
          </KnobComposed>
          <KnobComposed>
            <TooltipId>EffectUnit_master_enabled</TooltipId>
            <ObjectName>RbCfxChannelKnob</ObjectName>
            <Size>20f,20f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>8.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="FxUnitGroup"/>,group_Master_enable</ConfigKey>
            </Connection>
          </KnobComposed>
        </Children>
      </WidgetGroup>

      <!-- CFX type selector buttons (9 types) -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>FILTER</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Filter</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>NOISE</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>WhiteNoise</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>CRUSH</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Bitcrusher</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>SPACE</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Reverb</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>DUB ECHO</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Echo</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>SWEEP</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Sweep</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>PITCH</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>PitchShift</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>JET</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Flanger</Add></Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxTypeButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>GATE</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>GateComp</Add></Transform>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
