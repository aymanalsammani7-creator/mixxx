<!-- CUSTOM MOD (rekordbox-skin): Rekordbox-style layout for local Mixxx build -->
<!--
  Rekordbox-style CFX mini panel for one deck.
  Loads named effects into that deck's quick effect slot via
  [<QuickEffectRack1_[ChannelN]_EffectSlot1>],load_effect_by_name (string).
  DEFAULT unloads the slot via the "clear" ControlPushButton.
  Variables:
    ChanNum : 1..4

  INDEX SCHEME: effects are loaded by display name, so the order of the
  visible-effects list no longer matters. This is stable across effect
  registration changes.
-->

<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <SetVariable name="QuickEffectRack">[QuickEffectRack1_<Variable name="Group"/>]</SetVariable>
  <SetVariable name="QuickEffectSlot">[QuickEffectRack1_<Variable name="Group"/>_EffectSlot1]</SetVariable>

  <WidgetGroup>
    <ObjectName>RbCfxPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <Label>
        <ObjectName>RbCfxHeader</ObjectName>
        <Size>me,16f</Size>
        <Text>CFX&#8202;<Variable name="ChanNum"/></Text>
      </Label>

      <WidgetGroup><!-- effect selector buttons -->
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>

          <PushButton><!-- unload quick effect -->
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>DEFAULT</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,clear</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <!-- Reverb: load by display name -->
          <PushButton>
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>SPACE</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Reverb</Add></Transform>
            </Connection>
          </PushButton>

          <PushButton><!-- Echo = load by display name -->
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>DUB ECHO</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Echo</Add></Transform>
            </Connection>
          </PushButton>

          <PushButton><!-- Flanger = load by display name -->
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>FLANGER</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Flanger</Add></Transform>
            </Connection>
          </PushButton>

          <PushButton><!-- Bitcrusher = load by display name -->
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>CRUSH</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Bitcrusher</Add></Transform>
            </Connection>
          </PushButton>

          <PushButton><!-- Filter = load by display name -->
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>FILTER</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Filter</Add></Transform>
            </Connection>
          </PushButton>

          <PushButton><!-- Sweep = load by display name -->
            <TooltipId>EffectSlot_enabled</TooltipId>
            <ObjectName>RbCfxButton</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>SWEEP</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectSlot"/>,load_effect_by_name</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <Transform><Add>Sweep</Add></Transform>
            </Connection>
          </PushButton>

        </Children>
      </WidgetGroup>

      <WidgetGroup><!-- macro knob + quick enable -->
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <KnobComposed>
            <TooltipId>QuickEffectRack_super1</TooltipId>
            <Size>30f,26f</Size>
            <Knob>skins:Rekordbox/graphics/knobs/knob_indicator_small_green.svg</Knob>
            <BackPath>skins:Rekordbox/graphics/knobs/knob_bg_small.svg</BackPath>
            <MinAngle>-130</MinAngle>
            <MaxAngle>130</MaxAngle>
            <ArcRadius>10.0</ArcRadius>
            <ArcUnipolar>true</ArcUnipolar>
            <ArcColor>#00a0e9</ArcColor>
            <ArcThickness>2</ArcThickness>
            <Connection>
              <ConfigKey><Variable name="QuickEffectRack"/>,super1</ConfigKey>
            </Connection>
          </KnobComposed>
          <PushButton><!-- momentary quick effect gate -->
            <TooltipId>QuickEffectRack_enabled</TooltipId>
            <ObjectName>RbCfxGate</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>FX ON</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>FX ON</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectRack"/>,enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton><!-- release fx toggle -->
            <TooltipId>release_fx</TooltipId>
            <ObjectName>RbCfxRelease</ObjectName>
            <Size>44f,20f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>REL</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>REL</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="QuickEffectRack"/>,release_fx_enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>

