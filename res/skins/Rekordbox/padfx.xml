<!-- CUSTOM MOD (rekordbox-skin): Rekordbox-style Pad FX panel -->
<!--
  Mode-dependent pad grid for EffectUnit4.
  Variables:
    ChanNum : deck whose label is shown (1 or 2)
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>

  <WidgetGroup>
    <ObjectName>RbPadFxPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <Label>
        <ObjectName>RbPadFxHeader</ObjectName>
        <Size>me,16f</Size>
        <Text>PAD FX D&#8202;<Variable name="ChanNum"/></Text>
      </Label>

      <!-- Pad mode selector -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <PushButton>
            <ObjectName>RbPadModeSelect</ObjectName>
            <Size>60,20</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>PAD FX</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,pad_mode</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RbPadBank1</ObjectName>
            <Size>20,20</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>1</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>1</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,pad_fx_bank</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>RbPadBank2</ObjectName>
            <Size>20,20</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>2</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>2</Text>
