<!-- CUSTOM MOD (rekordbox-skin): Rekordbox 7.x Performance Mode layout for Mixxx -->
<!--
  Band order (top to bottom) matching spec v1.1:
    ROW 1: Beat FX (FX1 + FX2)
    ROW 2: CFX row (4 decks)
    ROW 3: MERGE FX row (MFX1/MFX2)
    ROW 4: Waveform overview (full-width, 4 decks)
    ROW 5: Waveform zoomed (full-width, 4 decks)
    ROW 6: Deck headers + mini-waveform + stems (4 decks)
    ROW 7: Jog wheels + mixer cluster (4 decks + master)
    ROW 8: Pad FX (4 decks)
    ROW 9: Recording + Automix
    ROW 10: Library
-->
<!DOCTYPE skin>
<skin>
  <manifest>
    <title>Rekordbox Dark</title>
    <author>Kilo (AI-assisted local mod)</author>
    <version>1.2.0</version>
    <description>Rekordbox 7.x Performance Mode dark skin for Mixxx. 4-deck layout with Beat FX, CFX, Merge FX, waveforms, deck headers, jog wheels, mixer, and Pad FX.</description>
    <language>en</language>
    <license>GPLv2+</license>
    <attributes>
      <attribute config_key="[App],num_decks">4</attribute>
      <attribute config_key="[App],num_samplers">4</attribute>
    </attributes>
  </manifest>

  <ObjectName>Mixxx</ObjectName>
  <Style src="skins:Rekordbox/qss/Rekordbox.qss"/>
  <MinimumSize>1280,800</MinimumSize>
  <SizePolicy>me,me</SizePolicy>
  <Layout>vertical</Layout>
  <Children>

    <!-- ROW 1: Beat FX racks -->
    <WidgetGroup>
      <ObjectName>RbRowBeatFx</ObjectName>
      <Layout>horizontal</Layout>
      <Size>1280,100</Size>
      <Children>
        <Template src="skins:Rekordbox/fxunit.xml">
          <SetVariable name="FxUnit">1</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/fxunit.xml">
          <SetVariable name="FxUnit">2</SetVariable>
        </Template>
      </Children>
    </WidgetGroup>

    <!-- ROW 2: CFX row -->
    <WidgetGroup>
      <ObjectName>RbRowCfx</ObjectName>
      <Layout>horizontal</Layout>
      <Size>1280,60</Size>
      <Children>
        <Template src="skins:Rekordbox/cfx.xml">
          <SetVariable name="ChanNum">1</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/cfx.xml">
          <SetVariable name="ChanNum">2</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/cfx.xml">
          <SetVariable name="ChanNum">3</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/cfx.xml">
          <SetVariable name="ChanNum">4</SetVariable>
        </Template>
      </Children>
    </WidgetGroup>

    <!-- ROW 3: MERGE FX row -->
    <WidgetGroup>
      <ObjectName>RbRowMergeFx</ObjectName>
      <Layout>horizontal</Layout>
      <Size>1280,100</Size>
      <Children>
        <Template src="skins:Rekordbox/mergefx.xml"/>
      </Children>
    </WidgetGroup>

    <!-- ROW 4: Waveform overview (full-width) -->
    <WidgetGroup>
      <ObjectName>RbRowWaveformOverview</ObjectName>
      <Layout>horizontal</Layout>
      <Size>1280,80</Size>
      <Children>
        <Template src="skins:Rekordbox/waveform_overview.xml">
          <SetVariable name="ChanNum">1</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/waveform_overview.xml">
          <SetVariable name="ChanNum">2</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/waveform_overview.xml">
          <SetVariable name="ChanNum">3</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/waveform_overview.xml">
          <SetVariable name="ChanNum">4</SetVariable>
        </Template>
      </Children>
    </WidgetGroup>

    <!-- ROW 5: Waveform zoomed (full-width) -->
    <WidgetGroup>
      <ObjectName>RbRowWaveformZoomed</ObjectName>
      <Layout>horizontal</Layout>
      <Size>1280,80</Size>
      <Children>
        <Template src="skins:Rekordbox/waveform_zoomed.xml">
          <SetVariable name="ChanNum">1</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/waveform_zoomed.xml">
          <SetVariable name="ChanNum">2</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/waveform_zoomed.xml">
          <SetVariable name="ChanNum">3</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/waveform_zoomed.xml">
          <SetVariable name="ChanNum">4</SetVariable>
        </Template>
      </Children>
    </WidgetGroup>

    <!-- ROW 6: Deck headers + mini-waveform + stems -->
    <WidgetGroup>
      <ObjectName>RbRowDeckHeaders</ObjectName>
      <Layout>horizontal</Layout>
      <Size>1280,60</Size>
      <Children>
        <Template src="skins:Rekordbox/deckheader.xml">
          <SetVariable name="ChanNum">1</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/deckheader.xml">
          <SetVariable name="ChanNum">2</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/deckheader.xml">
          <SetVariable name="ChanNum">3</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/deckheader.xml">
          <SetVariable name="ChanNum">4</SetVariable>
        </Template>
      </Children>
    </WidgetGroup>

    <!-- ROW 7: Jog wheels + mixer cluster -->
    <WidgetGroup>
      <ObjectName>RbRowJogMixer</ObjectName>
      <Layout>horizontal</Layout>
      <Size>1280,280</Size>
      <Children>
        <Template src="skins:Rekordbox/jogwheel.xml">
          <SetVariable name="ChanNum">1</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/jogwheel.xml">
          <SetVariable name="ChanNum">2</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/jogwheel.xml">
          <SetVariable name="ChanNum">3</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/jogwheel.xml">
          <SetVariable name="ChanNum">4</SetVariable>
        </Template>
        <!-- Center mixer -->
        <WidgetGroup>
          <ObjectName>RbCenterMixer</ObjectName>
          <Layout>vertical</Layout>
          <SizePolicy>min,min</SizePolicy>
          <Children>
            <Template src="skins:Rekordbox/channelstrip.xml">
              <SetVariable name="ChanNum">1</SetVariable>
            </Template>
            <Template src="skins:Rekordbox/channelstrip.xml">
              <SetVariable name="ChanNum">2</SetVariable>
            </Template>
            <Template src="skins:Rekordbox/channelstrip.xml">
              <SetVariable name="ChanNum">3</SetVariable>
            </Template>
            <Template src="skins:Rekordbox/channelstrip.xml">
              <SetVariable name="ChanNum">4</SetVariable>
            </Template>
            <!-- Master + crossfader -->
            <WidgetGroup>
              <ObjectName>RbMasterSection</ObjectName>
              <Layout>horizontal</Layout>
              <SizePolicy>min,min</SizePolicy>
              <Children>
                <SliderComposed>
                  <TooltipId>main_gain</TooltipId>
                  <Size>42f,110f</Size>
                  <Handle scalemode="STRETCH_ASPECT">skins:Rekordbox/graphics/sliders/knob_volume_deck.svg</Handle>
                  <Slider scalemode="STRETCH_ASPECT">skins:Rekordbox/graphics/sliders/slider_volume_deck.svg</Slider>
                  <Horizontal>false</Horizontal>
                  <BarColor>#00a0e9</BarColor>
                  <BarWidth>2</BarWidth>
                  <BarMargins>8,8</BarMargins>
                  <BarRoundCaps>true</BarRoundCaps>
                  <BarAxisPos>21.0</BarAxisPos>
                  <Connection>
                    <ConfigKey>[Master],gain</ConfigKey>
                  </Connection>
                </SliderComposed>
                <SliderComposed>
                  <TooltipId>crossfader</TooltipId>
                  <Size>190f,30f</Size>
                  <Handle scalemode="STRETCH_ASPECT">skins:Rekordbox/graphics/sliders/knob_crossfader.svg</Handle>
                  <Slider scalemode="STRETCH_ASPECT">skins:Rekordbox/graphics/sliders/slider_crossfader_small.svg</Slider>
                  <Horizontal>true</Horizontal>
                  <BarColor>#00a0e9</BarColor>
                  <BarWidth>2</BarWidth>
                  <BarMargins>7,7</BarMargins>
                  <BarRoundCaps>true</BarRoundCaps>
                  <Connection>
                    <ConfigKey>[Master],crossfader</ConfigKey>
                  </Connection>
                </SliderComposed>
              </Children>
            </WidgetGroup>
          </Children>
        </WidgetGroup>
      </Children>
    </WidgetGroup>

    <!-- ROW 8: Pad FX (below jog/mixer) -->
    <WidgetGroup>
      <ObjectName>RbRowPadFx</ObjectName>
      <Layout>horizontal</Layout>
      <Size>1280,80</Size>
      <Children>
        <Template src="skins:Rekordbox/padfx.xml">
          <SetVariable name="ChanNum">1</SetVariable>
        </Template>
        <Template src="skins:Rekordbox/padfx.xml">
          <SetVariable name="ChanNum">2</SetVariable>
        </Template>
      </Children>
    </WidgetGroup>

    <!-- ROW 9: Recording + Automix -->
    <WidgetGroup>
        <ObjectName>RbRowRecordingAutomix</ObjectName>
        <Layout>horizontal</Layout>
        <Size>1280,100</Size>
        <Children>
            <Template src="skins:Rekordbox/recording.xml"/>
            <Template src="skins:Rekordbox/automix.xml"/>
        </Children>
    </WidgetGroup>

    <!-- ROW 10: Library -->
    <Template src="skins:Rekordbox/library.xml"/>

  </Children>
</skin>
