<!-- CUSTOM MOD (rekordbox-skin): Rekordbox-style layout for local Mixxx build -->
<!--
  Rekordbox-style deck pod: deck card header (deck + artist/title | BPM | time),
  overview waveform, transport, rate fader and a 2x4 hotcue grid (A..H).
  Variables:
    ChanNum : 1..4
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>

  <WidgetGroup>
    <ObjectName>RbDeckPod</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>i,min</SizePolicy>
    <Children>

      <!-- deck card header: DECK + artist/title | BPM | time/status -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <Children>
              <Label>
                <ObjectName>RbDeckTitle</ObjectName>
                <Size>90f,14f</Size>
                <!-- === CUSTOM MOD (rekordbox-fix): normal space between DECK and number === -->
                <Text>DECK <Variable name="ChanNum"/></Text>
              </Label>
              <Label>
                <TooltipId>songauthor</TooltipId>
                <ObjectName>RbDeckArtist</ObjectName>
                <Size>90f,11f</Size>
                <Text>Artist</Text>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_author</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                </Connection>
              </Label>
              <Label>
                <TooltipId>songtitle</TooltipId>
                <ObjectName>RbDeckTrack</ObjectName>
                <Size>90f,11f</Size>
                <Text>Title</Text>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_title</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                </Connection>
              </Label>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <Label>
                <Text>BPM</Text>
              </Label>
              <ValueLabel>
                <TooltipId>beats</TooltipId>
                <ObjectName>RbBpmValue</ObjectName>
                <Size>48f,14f</Size>
                <!-- === CUSTOM MOD (rekordbox-fix): Precision=1 shows 128.0 like Rekordbox === -->
                <Precision>1</Precision>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,bpm</ConfigKey>
                </Connection>
              </ValueLabel>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>min,me</SizePolicy>
            <Children>
              <ValueLabel>
                <TooltipId>time</TooltipId>
                <ObjectName>RbRemainingTime</ObjectName>
                <Size>70f,14f</Size>
                <!-- === CUSTOM MOD (rekordbox-fix): plain playposition with Precision=2 === -->
                <Precision>2</Precision>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                </Connection>
              </ValueLabel>
              <Label>
                <TooltipId>duration</TooltipId>
                <ObjectName>RbTotalTime</ObjectName>
                <Size>70f,14f</Size>
                <Text>-0:00.0</Text>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,duration</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                  <TransformFunction>DurationToClock</TransformFunction>
                </Connection>
              </Label>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetGroup>

      <!-- overview waveform (light background) -->
      <Overview>
        <TooltipId>waveform_overview</TooltipId>
        <Size>-1me,60f</Size>
        <Group><Variable name="Group"/></Group>
        <BgColor>#FFFFFF</BgColor>
        <!-- === CUSTOM MOD (rekordbox-fix): darker signal color for Rekordbox look === -->
        <SignalColor>#4a4a4a</SignalColor>
        <SignalHighColor>#00a0e9</SignalHighColor>
        <SignalMidColor>#9b59b6</SignalMidColor>
        <SignalLowColor>#e67e22</SignalLowColor>
        <PlayPosColor>#00a0e9</PlayPosColor>
        <CueColor>#ff7a01</CueColor>
        <LoopColor>#00b400</LoopColor>
        <PlayedOverlayColor>#dd151515</PlayedOverlayColor>
        <EndOfTrackColor>#f856e7</EndOfTrackColor>
        <DefaultMark>
          <Align>bottom|right</Align>
          <Color>#FF0000</Color>
          <TextColor>#1a1a1a</TextColor>
          <Text> %1 </Text>
        </DefaultMark>
        <Mark>
          <Control>cue_point</Control>
          <Text>C</Text>
          <Align>top|right</Align>
          <Color>#ff7a01</Color>
          <TextColor>#1a1a1a</TextColor>
        </Mark>
        <MarkRange>
          <StartControl>loop_start_position</StartControl>
          <EndControl>loop_end_position</EndControl>
          <EnabledControl>loop_enabled</EnabledControl>
          <Color>#00b400</Color>
          <Opacity>0.8</Opacity>
          <DisabledColor>#1a1a1a</DisabledColor>
          <DisabledOpacity>0.6</DisabledOpacity>
        </MarkRange>
        <Connection>
          <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
        </Connection>
      </Overview>

      <!-- transport -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <PushButton><!-- play / pause -->
            <TooltipId>play</TooltipId>
            <ObjectName>RbPlayButton</ObjectName>
            <Size>56f,26f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>PLAY</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>PAUSE</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,play</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <CueButton>
            <TooltipId>cue_default_cue_gotoandstop</TooltipId>
            <ObjectName>RbCueButton</ObjectName>
            <Size>42f,26f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>true</RightClickIsPushButton>
            <Group><Variable name="Group"/></Group>
            <State>
              <Number>0</Number>
              <Text>CUE</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>CUE</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_default</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_gotoandstop</ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_indicator</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </CueButton>

          <PushButton><!-- sync -->
            <TooltipId>sync_enabled</TooltipId>
            <ObjectName>RbSyncButton</ObjectName>
            <Size>42f,26f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>SYNC</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>SYNC</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,sync_enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <PushButton><!-- quantize -->
            <TooltipId>quantize</TooltipId>
            <ObjectName>RbQuantizeButton</ObjectName>
            <Size>30f,26f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>Q</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>Q</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,quantize</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <PushButton><!-- slip mode -->
            <TooltipId>slip_enabled</TooltipId>
            <ObjectName>RbSlipButton</ObjectName>
            <Size>34f,26f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>SLIP</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>SLIP</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,slip_enabled</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <Label>
            <ObjectName>RbSlipIndicator</ObjectName>
            <Size>24f,26f</Size>
            <Text></Text>
            <Connection>
              <ConfigKey><Variable name="Group"/>,slip_enabled</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </Label>

        </Children>
      </WidgetGroup>

      <!-- horizontal rate fader -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <SliderComposed>
            <TooltipId>rate</TooltipId>
            <Size>148f,24f</Size>
            <Handle scalemode="STRETCH_ASPECT">skins:Rekordbox/graphics/sliders/knob_crossfader.svg</Handle>
            <Slider scalemode="STRETCH_ASPECT">skins:Rekordbox/graphics/sliders/slider_crossfader_small.svg</Slider>
            <Horizontal>true</Horizontal>
            <BarColor>#00a0e9</BarColor>
            <BarWidth>2</BarWidth>
            <BarMargins>7,7</BarMargins>
            <BarRoundCaps>true</BarRoundCaps>
            <BarUnipolar>false</BarUnipolar>
            <BarAxisPos>74.0</BarAxisPos>
            <Connection>
              <ConfigKey><Variable name="Group"/>,rate</ConfigKey>
            </Connection>
          </SliderComposed>
          <PushButton><!-- master tempo / keylock -->
            <TooltipId>keylock</TooltipId>
            <ObjectName>RbKeylockButton</ObjectName>
            <Size>30f,24f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>false</RightClickIsPushButton>
            <State>
              <Number>0</Number>
              <Text>MT</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text>MT</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,keylock</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <ValueLabel>
            <ObjectName>RbKeyShiftValue</ObjectName>
            <Size>30f,24f</Size>
            <Precision>1</Precision>
            <Connection>
              <ConfigKey><Variable name="Group"/>,pitch_adjust</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </ValueLabel>
          <PushButton><!-- rate reset -->
            <ObjectName>RbRateReset</ObjectName>
            <Size>30f,24f</Size>
            <NumberStates>1</NumberStates>
            <State>
              <Number>0</Number>
              <Text>R</Text>
              <Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,rate_set_default</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <!-- hotcue pad grid 2x4 (1..8) -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <WidgetGroup><!-- row 1: hotcues 1-4 -->
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <HotcueButton>
                <TooltipId>hotcue</TooltipId>
                <ObjectName>RbHotcueButton</ObjectName>
                <Size>36f,26f</Size>
                <Group><Variable name="Group"/></Group>
                <Hotcue>1</Hotcue>
                <NumberStates>3</NumberStates>
                <State><Number>0</Number><Text>1</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>1</Number><Text>1</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>2</Number><Text>1</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
              </HotcueButton>
              <HotcueButton>
                <TooltipId>hotcue</TooltipId>
                <ObjectName>RbHotcueButton</ObjectName>
                <Size>36f,26f</Size>
                <Group><Variable name="Group"/></Group>
                <Hotcue>2</Hotcue>
                <NumberStates>3</NumberStates>
                <State><Number>0</Number><Text>2</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>1</Number><Text>2</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>2</Number><Text>2</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
              </HotcueButton>
              <HotcueButton>
                <TooltipId>hotcue</TooltipId>
                <ObjectName>RbHotcueButton</ObjectName>
                <Size>36f,26f</Size>
                <Group><Variable name="Group"/></Group>
                <Hotcue>3</Hotcue>
                <NumberStates>3</NumberStates>
                <State><Number>0</Number><Text>3</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>1</Number><Text>3</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>2</Number><Text>3</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
              </HotcueButton>
              <HotcueButton>
                <TooltipId>hotcue</TooltipId>
                <ObjectName>RbHotcueButton</ObjectName>
                <Size>36f,26f</Size>
                <Group><Variable name="Group"/></Group>
                <Hotcue>4</Hotcue>
                <NumberStates>3</NumberStates>
                <State><Number>0</Number><Text>4</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>1</Number><Text>4</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>2</Number><Text>4</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
              </HotcueButton>
            </Children>
          </WidgetGroup>

          <WidgetGroup><!-- row 2: hotcues 5-8 -->
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <HotcueButton>
                <TooltipId>hotcue</TooltipId>
                <ObjectName>RbHotcueButton</ObjectName>
                <Size>36f,26f</Size>
                <Group><Variable name="Group"/></Group>
                <Hotcue>5</Hotcue>
                <NumberStates>3</NumberStates>
                <State><Number>0</Number><Text>5</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>1</Number><Text>5</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>2</Number><Text>5</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
              </HotcueButton>
              <HotcueButton>
                <TooltipId>hotcue</TooltipId>
                <ObjectName>RbHotcueButton</ObjectName>
                <Size>36f,26f</Size>
                <Group><Variable name="Group"/></Group>
                <Hotcue>6</Hotcue>
                <NumberStates>3</NumberStates>
                <State><Number>0</Number><Text>6</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>1</Number><Text>6</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>2</Number><Text>6</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
              </HotcueButton>
              <HotcueButton>
                <TooltipId>hotcue</TooltipId>
                <ObjectName>RbHotcueButton</ObjectName>
                <Size>36f,26f</Size>
                <Group><Variable name="Group"/></Group>
                <Hotcue>7</Hotcue>
                <NumberStates>3</NumberStates>
                <State><Number>0</Number><Text>7</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>1</Number><Text>7</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>2</Number><Text>7</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
              </HotcueButton>
              <HotcueButton>
                <TooltipId>hotcue</TooltipId>
                <ObjectName>RbHotcueButton</ObjectName>
                <Size>36f,26f</Size>
                <Group><Variable name="Group"/></Group>
                <Hotcue>8</Hotcue>
                <NumberStates>3</NumberStates>
                <State><Number>0</Number><Text>8</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>1</Number><Text>8</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
                <State><Number>2</Number><Text>8</Text><Unpressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Unpressed><Pressed scalemode="STRETCH">skins:Rekordbox/graphics/btn_light_active.svg</Pressed></State>
              </HotcueButton>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
